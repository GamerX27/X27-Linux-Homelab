#!/bin/sh
# keepalived's health check for the dashboard's virtual IP: the dashboard answers on its
# port (any HTTP status counts). It lives here because SELinux lets keepalived run scripts
# unconfined only from /usr/libexec/keepalived; a confined one can't reach the port.
exec /usr/bin/curl -ks -o /dev/null --max-time 2 "https://127.0.0.1:${1:-9090}/"
