#!/usr/bin/env bash
# fish-default-shell.service: /etc/default/useradd only gives fish to users created after
# fish was added, so this switches existing regular users (UID 1000-59999) whose login shell
# is bash. Once per user (tracked in $STATE): a later `chsh` back to bash is kept.
set -euo pipefail

FISH=/usr/bin/fish
STATE=/var/lib/fish-default-shell/done

[[ -x "$FISH" ]] || exit 0
mkdir -p "${STATE%/*}"
touch "$STATE"
grep -qx "$FISH" /etc/shells || echo "$FISH" >>/etc/shells

awk -F: '$3 >= 1000 && $3 < 60000 { print $1 ":" $7 }' /etc/passwd | while IFS=: read -r user shell; do
  grep -qx "$user" "$STATE" && continue
  case "$shell" in
    /bin/bash|/usr/bin/bash)
      usermod -s "$FISH" "$user"
      echo "${user}: login shell set to fish"
      ;;
  esac
  echo "$user" >>"$STATE"
done
