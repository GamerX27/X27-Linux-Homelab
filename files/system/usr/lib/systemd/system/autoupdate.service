[Unit]
Description=X27-Linux Homelab automatic update
Documentation=man:rpm-ostree(1)
ConditionPathExists=/run/ostree-booted
Wants=network-online.target
After=network-online.target

# Stages an update and reboots only when one was staged. Sends a Gotify message first if set up.
# Progress goes to /var/lib/autoupdate (see /usr/libexec/autoupdate-run).
[Service]
Type=oneshot
StateDirectory=autoupdate
ExecStart=/usr/libexec/autoupdate-run
